{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songreel-poc",
  // Account Qquankun@gmail.com. Pin cung de khong deploy nham account.
  "account_id": "6a959e87aaf889d75de1f587de9f89cb",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "songreel", "database_id": "249a274e-e6d9-4ed6-ac4b-ece5169b832b"}
  ],
  "kv_namespaces": [
    {"binding": "BLOBS", "id": "8227a667405d47c8b65221be6dd4304f"}
  ],
  // Day cac don dang do khi khach da dong tab
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true}
}
